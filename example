<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CryptoLab Ultimate Console</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        bg: '#050507',
                        surface: '#0E0E12',
                        surface2: '#18181F',
                        border: '#272730',
                        primary: '#3B82F6',
                        accent: '#8B5CF6',
                        success: '#10B981',
                        danger: '#EF4444',
                        warning: '#F59E0B',
                        text: '#E2E8F0',
                        muted: '#64748B',
                    },
                    boxShadow: {
                        'glow': '0 0 20px -5px var(--tw-shadow-color)',
                        'modal': '0 0 50px -12px rgba(0, 0, 0, 0.8)',
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #050507; }
        ::-webkit-scrollbar-thumb { background: #272730; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #3B82F6; }

        .chart-grid {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
        }

        .glass-panel {
            background: rgba(14, 14, 18, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .input-cyber {
            @apply bg-surface2 border border-border rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all font-mono w-full;
        }

        /* Animations */
        .fade-enter { animation: fade-in 0.3s ease-out; }
        @keyframes fade-in { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        
        /* Modal Animation */
        .modal-enter { animation: modal-in 0.2s ease-out forwards; }
        @keyframes modal-in { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
    </style>
</head>
<body class="bg-bg text-text font-sans h-screen flex overflow-hidden selection:bg-primary selection:text-white relative">

    <!-- Sidebar Navigation -->
    <aside class="w-20 lg:w-64 border-r border-border bg-surface flex flex-col justify-between flex-shrink-0 z-40">
        <div>
            <div class="h-16 flex items-center justify-center lg:justify-start lg:px-6 border-b border-border">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold shadow-glow shadow-primary/50">
                    <i class="ph-bold ph-chart-polar"></i>
                </div>
                <span class="ml-3 font-mono font-bold text-lg hidden lg:block tracking-tighter">CRYPTO<span class="text-primary">LAB</span></span>
            </div>

            <nav class="mt-6 px-2 space-y-1">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-item w-full flex items-center px-3 py-3 rounded-lg text-muted hover:text-white hover:bg-white/5 transition-all">
                    <i class="ph ph-squares-four text-xl"></i>
                    <span class="ml-3 font-medium hidden lg:block">Дашборд</span>
                </button>
                <button onclick="switchTab('backtester')" id="nav-backtester" class="nav-item w-full flex items-center px-3 py-3 rounded-lg bg-primary/10 text-primary transition-all">
                    <i class="ph-fill ph-graph text-xl"></i>
                    <span class="ml-3 font-medium hidden lg:block">Бэктестер</span>
                </button>
                <button onclick="switchTab('scanner')" id="nav-scanner" class="nav-item w-full flex items-center px-3 py-3 rounded-lg text-muted hover:text-white hover:bg-white/5 transition-all">
                    <i class="ph ph-radar text-xl"></i>
                    <span class="ml-3 font-medium hidden lg:block">Сканер</span>
                </button>
                <button onclick="switchTab('queue')" id="nav-queue" class="nav-item w-full flex items-center px-3 py-3 rounded-lg text-muted hover:text-white hover:bg-white/5 transition-all">
                    <i class="ph ph-queue text-xl"></i>
                    <span class="ml-3 font-medium hidden lg:block">Очередь</span>
                    <span class="ml-auto bg-surface2 text-xs font-mono py-0.5 px-2 rounded text-muted hidden lg:block">3</span>
                </button>
                <button onclick="switchTab('data')" id="nav-data" class="nav-item w-full flex items-center px-3 py-3 rounded-lg text-muted hover:text-white hover:bg-white/5 transition-all">
                    <i class="ph ph-database text-xl"></i>
                    <span class="ml-3 font-medium hidden lg:block">Данные</span>
                </button>
            </nav>
        </div>

        <div class="p-4 border-t border-border">
            <button onclick="switchTab('settings')" id="nav-settings" class="nav-item w-full flex items-center px-3 py-3 rounded-lg text-muted hover:text-white hover:bg-white/5 transition-all">
                <i class="ph ph-gear text-xl"></i>
                <span class="ml-3 font-medium hidden lg:block">Настройки</span>
            </button>
            <div class="mt-4 flex items-center gap-3 px-3 hidden lg:flex">
                <div class="w-8 h-8 rounded-full bg-gradient-to-r from-success to-emerald-600"></div>
                <div class="overflow-hidden">
                    <div class="text-sm font-medium truncate">Admin User</div>
                    <div class="text-xs text-muted font-mono">v2.4.1-beta</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col min-w-0 relative bg-chart-grid">
        
        <!-- Header -->
        <header class="h-16 border-b border-border bg-bg/80 backdrop-blur-md flex items-center justify-between px-6 sticky top-0 z-30">
            <div class="flex items-center gap-4">
                <h2 id="page-title" class="text-lg font-semibold">Бэктестер</h2>
                <div class="h-4 w-px bg-border mx-2"></div>
                <!-- System Health Mini -->
                <div class="flex items-center gap-4">
                     <div class="flex items-center gap-2 text-xs font-mono bg-surface2 px-2 py-1 rounded border border-border" title="System Health">
                        <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
                        <span>SYSTEM: OK</span>
                    </div>
                     <div class="flex items-center gap-2 text-xs font-mono bg-surface2 px-2 py-1 rounded border border-border" title="API Status">
                        <i class="ph-fill ph-plugs text-primary"></i>
                        <span>BYBIT: 45ms</span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <button onclick="toggleAIPanel()" class="group relative px-3 py-1.5 rounded-lg border border-primary/30 bg-primary/10 hover:bg-primary/20 transition-all flex items-center gap-2">
                    <i class="ph-fill ph-sparkle text-primary animate-pulse"></i>
                    <span class="text-sm font-medium text-primary hidden md:inline">Gemini AI</span>
                </button>
                <button class="w-9 h-9 rounded-lg border border-border flex items-center justify-center hover:bg-surface2 transition-colors text-muted relative">
                    <i class="ph ph-bell"></i>
                    <span class="absolute top-2 right-2 w-2 h-2 bg-danger rounded-full border border-bg"></span>
                </button>
            </div>
        </header>

        <!-- VIEWS CONTAINER -->
        <div id="views-container" class="flex-1 overflow-y-auto p-6 relative">
            
            <!-- 1. DASHBOARD VIEW (HomeView.vue) -->
            <div id="view-dashboard" class="hidden fade-enter space-y-6">
                <!-- System Health Cards Row -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- CPU/RAM -->
                    <div class="bg-surface border border-border rounded-xl p-5">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-medium text-white flex items-center gap-2"><i class="ph-fill ph-cpu text-primary"></i> System Health</h3>
                            <span class="text-xs text-success bg-success/10 px-2 py-1 rounded">Stable</span>
                        </div>
                        <div class="space-y-4">
                            <div>
                                <div class="flex justify-between text-xs mb-1 text-muted"><span>CPU Load</span><span>12%</span></div>
                                <div class="w-full bg-bg h-1.5 rounded-full overflow-hidden"><div class="bg-primary h-full w-[12%]"></div></div>
                            </div>
                            <div>
                                <div class="flex justify-between text-xs mb-1 text-muted"><span>Memory</span><span>4.2GB / 16GB</span></div>
                                <div class="w-full bg-bg h-1.5 rounded-full overflow-hidden"><div class="bg-accent h-full w-[26%]"></div></div>
                            </div>
                        </div>
                    </div>
                    <!-- Database Status -->
                    <div class="bg-surface border border-border rounded-xl p-5">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-medium text-white flex items-center gap-2"><i class="ph-fill ph-database text-warning"></i> Database</h3>
                            <span class="text-xs text-muted">PostgreSQL</span>
                        </div>
                        <div class="grid grid-cols-2 gap-4 text-center">
                            <div class="p-2 bg-surface2 rounded-lg">
                                <div class="text-xl font-mono font-bold text-white">14.2M</div>
                                <div class="text-[10px] text-muted uppercase mt-1">Candles</div>
                            </div>
                            <div class="p-2 bg-surface2 rounded-lg">
                                <div class="text-xl font-mono font-bold text-white">128</div>
                                <div class="text-[10px] text-muted uppercase mt-1">Pairs</div>
                            </div>
                        </div>
                    </div>
                    <!-- Active Jobs -->
                    <div class="bg-surface border border-border rounded-xl p-5 relative overflow-hidden">
                        <div class="absolute right-0 top-0 p-4 opacity-5"><i class="ph-fill ph-lightning text-6xl"></i></div>
                        <h3 class="font-medium text-white mb-2">Active Jobs</h3>
                        <div class="text-4xl font-mono font-bold text-white">3</div>
                        <p class="text-sm text-muted mt-2">Processing backtests & data sync</p>
                         <button onclick="switchTab('queue')" class="mt-4 text-xs text-primary hover:underline">View Queue &rarr;</button>
                    </div>
                </div>

                <!-- Recent Performance -->
                <h3 class="text-lg font-bold">Recent Performance</h3>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="bg-surface border border-border rounded-xl p-5">
                        <div class="text-xs text-muted uppercase font-bold">Total PnL</div>
                        <div class="text-2xl font-mono text-success mt-1">+$4,291.50</div>
                        <div class="text-xs text-success mt-1">+12.4% this month</div>
                    </div>
                    <div class="bg-surface border border-border rounded-xl p-5">
                        <div class="text-xs text-muted uppercase font-bold">Win Rate</div>
                        <div class="text-2xl font-mono text-primary mt-1">68.2%</div>
                        <div class="h-1 w-full bg-surface2 mt-2 rounded-full overflow-hidden"><div class="h-full bg-primary w-[68%]"></div></div>
                    </div>
                     <div class="bg-surface border border-border rounded-xl p-5">
                        <div class="text-xs text-muted uppercase font-bold">Avg Trade</div>
                        <div class="text-2xl font-mono text-white mt-1">+$42.10</div>
                    </div>
                     <div class="bg-surface border border-border rounded-xl p-5">
                        <div class="text-xs text-muted uppercase font-bold">Sharpe Ratio</div>
                        <div class="text-2xl font-mono text-accent mt-1">2.14</div>
                    </div>
                </div>
            </div>

            <!-- 2. BACKTESTER VIEW (BacktesterView.vue) -->
            <div id="view-backtester" class="fade-enter h-full flex flex-col gap-4">
                <!-- Toolbar -->
                <div class="flex flex-wrap items-center gap-4 bg-surface border border-border p-3 rounded-xl shadow-lg shrink-0">
                    <div class="flex items-center gap-2 border-r border-border pr-4">
                        <i class="ph-bold ph-coins text-muted"></i>
                        <select class="bg-transparent font-mono font-bold text-white focus:outline-none cursor-pointer text-sm">
                            <option>BTC/USDT</option>
                            <option>ETH/USDT</option>
                            <option>SOL/USDT</option>
                        </select>
                    </div>
                    <div class="flex items-center gap-2 border-r border-border pr-4">
                        <div class="flex gap-1 bg-bg p-0.5 rounded-lg border border-border">
                            <button class="px-3 py-1 text-xs rounded hover:bg-surface2 text-muted hover:text-white transition">15m</button>
                            <button class="px-3 py-1 text-xs rounded bg-surface2 text-white font-medium shadow-sm">1h</button>
                            <button class="px-3 py-1 text-xs rounded hover:bg-surface2 text-muted hover:text-white transition">4h</button>
                            <button class="px-3 py-1 text-xs rounded hover:bg-surface2 text-muted hover:text-white transition">1d</button>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 flex-1">
                        <span class="text-muted text-xs uppercase font-bold tracking-wider">Стратегия</span>
                        <select class="bg-surface2 border border-border rounded px-3 py-1.5 text-sm focus:outline-none w-full max-w-xs text-white">
                            <option>Dynamic Levels v2</option>
                            <option>RSI Momentum</option>
                            <option>MACD Divergence</option>
                        </select>
                    </div>
                    
                    <button onclick="analyzeStrategyWithAI()" class="bg-surface2 hover:bg-accent/20 border border-accent/30 text-accent px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2">
                        <i class="ph-fill ph-magic-wand"></i> AI Анализ
                    </button>

                    <button class="bg-primary hover:bg-blue-600 text-white px-6 py-2 rounded-lg font-medium text-sm shadow-glow shadow-primary/30 transition-all flex items-center gap-2">
                        <i class="ph-fill ph-play"></i> Запустить
                    </button>
                </div>

                <div class="flex-1 grid grid-cols-12 gap-4 min-h-0">
                    <!-- Left Column: Chart & Metrics -->
                    <div class="col-span-12 lg:col-span-9 flex flex-col gap-4 overflow-hidden">
                        <!-- Chart Area -->
                        <div class="flex-1 bg-surface border border-border rounded-xl relative overflow-hidden group min-h-[400px]">
                            <!-- Mock TradingView/Equity Chart -->
                            <div class="absolute inset-0 p-4 flex flex-col">
                                <div class="flex justify-between items-start mb-2 z-10">
                                    <div class="bg-bg/80 backdrop-blur border border-border px-3 py-1 rounded text-xs font-mono text-success">
                                        PNL Curve & Candles
                                    </div>
                                </div>
                                <!-- Visual Placeholder for Chart -->
                                <div class="flex-1 relative opacity-80">
                                    <!-- Simplified SVG Chart -->
                                    <svg class="w-full h-full" preserveAspectRatio="none">
                                        <defs>
                                            <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                                                <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.2"/>
                                                <stop offset="100%" stop-color="#3B82F6" stop-opacity="0"/>
                                            </linearGradient>
                                        </defs>
                                        <path d="M0,250 L50,240 L100,245 L150,210 L200,220 L250,190 L300,170 L350,180 L400,140 L450,150 L500,110 L550,100 L600,120 L650,90 L700,70 L750,80 L800,60 L900,55 L1000,65" fill="none" stroke="#3B82F6" stroke-width="2" vector-effect="non-scaling-stroke" />
                                        <path d="M0,250 L50,240 L100,245 L150,210 L200,220 L250,190 L300,170 L350,180 L400,140 L450,150 L500,110 L550,100 L600,120 L650,90 L700,70 L750,80 L800,60 L900,55 L1000,65 V300 H0 Z" fill="url(#chartGrad)" stroke="none" />
                                    </svg>
                                    <!-- Trade Markers -->
                                    <div onclick="openTradeModal()" class="absolute top-[30%] left-[40%] w-4 h-4 bg-success text-bg rounded-full flex items-center justify-center text-[8px] font-bold cursor-pointer hover:scale-125 transition shadow-lg shadow-success/50" title="Buy #124">B</div>
                                    <div onclick="openTradeModal()" class="absolute top-[20%] left-[60%] w-4 h-4 bg-danger text-white rounded-full flex items-center justify-center text-[8px] font-bold cursor-pointer hover:scale-125 transition shadow-lg shadow-danger/50" title="Sell #124">S</div>
                                </div>
                            </div>
                        </div>

                        <!-- PortfolioResultsDisplay.vue Component -->
                        <div class="bg-surface border border-border rounded-xl p-4 grid grid-cols-2 md:grid-cols-4 gap-4 h-40 shrink-0">
                            <div class="flex flex-col justify-center">
                                <span class="text-xs text-muted uppercase font-bold">Net Profit</span>
                                <span class="text-2xl font-mono text-success font-bold">+1,245.50</span>
                                <span class="text-xs text-muted">USDT</span>
                            </div>
                            <div class="flex flex-col justify-center">
                                <span class="text-xs text-muted uppercase font-bold">Total Trades</span>
                                <span class="text-2xl font-mono text-white font-bold">142</span>
                                <div class="flex gap-1 mt-1 text-[10px]"><span class="text-success">98 Win</span> / <span class="text-danger">44 Loss</span></div>
                            </div>
                            <div class="flex flex-col justify-center">
                                <span class="text-xs text-muted uppercase font-bold">Max Drawdown</span>
                                <span class="text-2xl font-mono text-danger font-bold">-5.2%</span>
                            </div>
                            <div class="flex flex-col justify-center">
                                <span class="text-xs text-muted uppercase font-bold">Profit Factor</span>
                                <span class="text-2xl font-mono text-primary font-bold">2.41</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Settings Tabs -->
                    <div class="col-span-12 lg:col-span-3 bg-surface border border-border rounded-xl flex flex-col overflow-hidden">
                        <!-- Tabs Header -->
                        <div class="flex border-b border-border">
                            <button onclick="switchSettingsTab('strategy')" id="tab-strategy" class="flex-1 py-3 text-xs font-bold uppercase tracking-wide text-primary border-b-2 border-primary bg-primary/5 transition-all">Strategy</button>
                            <button onclick="switchSettingsTab('portfolio')" id="tab-portfolio" class="flex-1 py-3 text-xs font-bold uppercase tracking-wide text-muted hover:text-white transition-all">Portfolio</button>
                        </div>

                        <!-- Settings Content -->
                        <div class="flex-1 overflow-y-auto p-4 custom-scrollbar">
                            <!-- StrategySettingsForm.vue -->
                            <div id="settings-strategy" class="space-y-5 fade-enter">
                                <div class="space-y-3">
                                    <label class="text-xs text-muted uppercase font-bold">Moving Averages</label>
                                    <div>
                                        <div class="flex justify-between text-xs mb-1"><span>Fast Length</span><span class="font-mono text-primary">9</span></div>
                                        <input id="input-fast-ma" type="range" class="w-full h-1 bg-bg rounded-lg appearance-none cursor-pointer [&::-webkit-slider-thumb]:bg-primary [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:rounded-full" min="1" max="50" value="9">
                                    </div>
                                    <div>
                                        <div class="flex justify-between text-xs mb-1"><span>Slow Length</span><span class="font-mono text-primary">21</span></div>
                                        <input id="input-slow-ma" type="range" class="w-full h-1 bg-bg rounded-lg appearance-none cursor-pointer [&::-webkit-slider-thumb]:bg-primary [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:rounded-full" min="10" max="200" value="21">
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <label class="text-xs text-muted uppercase font-bold">Oscillators</label>
                                    <div>
                                        <label class="block text-xs font-medium text-muted mb-1">RSI Period</label>
                                        <input type="number" value="14" class="input-cyber">
                                    </div>
                                </div>
                            </div>

                            <!-- PortfolioSettingsForm.vue -->
                            <div id="settings-portfolio" class="hidden space-y-5 fade-enter">
                                <div class="space-y-3">
                                    <label class="text-xs text-muted uppercase font-bold">Risk Parameters</label>
                                    <div>
                                        <label class="block text-xs font-medium text-muted mb-1">Initial Capital</label>
                                        <input type="text" value="10000" class="input-cyber">
                                    </div>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="block text-xs font-medium text-muted mb-1">Fee %</label>
                                            <input type="number" value="0.04" class="input-cyber">
                                        </div>
                                        <div>
                                            <label class="block text-xs font-medium text-muted mb-1">Slippage %</label>
                                            <input type="number" value="0.01" class="input-cyber">
                                        </div>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <label class="text-xs text-muted uppercase font-bold">Stop / Profit</label>
                                    <div>
                                        <label class="block text-xs font-medium text-muted mb-1">Stop Loss %</label>
                                        <input id="input-sl" type="number" value="1.5" class="input-cyber">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-muted mb-1">Take Profit %</label>
                                        <input id="input-tp" type="number" value="3.0" class="input-cyber">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Logs Section -->
                        <div class="border-t border-border p-4 bg-surface2/30">
                            <label class="text-xs text-muted uppercase font-bold tracking-wider mb-2 block">Live Logs</label>
                            <div class="bg-bg border border-border rounded p-2 text-[10px] font-mono text-muted h-24 overflow-y-auto custom-scrollbar">
                                <div class="text-success">> Strategy initialized</div>
                                <div>> Loaded 1400 candles</div>
                                <div class="text-warning">> Volatility spike detected</div>
                                <div>> Signal generated: BUY</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. SCANNER VIEW (ScannerView.vue) -->
            <div id="view-scanner" class="hidden fade-enter h-full flex flex-col">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold text-white">Рыночный Сканер</h2>
                    <div class="flex gap-2">
                        <button class="px-3 py-1.5 bg-surface border border-border rounded-lg text-sm hover:bg-surface2"><i class="ph ph-funnel"></i> Фильтры</button>
                        <button class="px-3 py-1.5 bg-primary text-white rounded-lg text-sm shadow-glow shadow-primary/20"><i class="ph-bold ph-arrows-clockwise"></i> Обновить</button>
                    </div>
                </div>

                <div class="bg-surface border border-border rounded-xl overflow-hidden">
                    <table class="w-full text-left">
                        <thead class="bg-surface2 text-xs uppercase text-muted font-bold">
                            <tr>
                                <th class="px-6 py-4">Пара</th>
                                <th class="px-6 py-4">Цена</th>
                                <th class="px-6 py-4">24h Изм.</th>
