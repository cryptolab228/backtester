    <!-- LOGIC -->
    <script>
        const apiKey = ""; 

        // --- NAVIGATION LOGIC ---
        function switchTab(tabId) {
            // UI Update
            document.querySelectorAll('.nav-item').forEach(btn => {
                if (btn.id === `nav-${tabId}`) {
                    btn.classList.remove('text-muted', 'hover:text-white', 'hover:bg-white/5');
                    btn.classList.add('bg-primary/10', 'text-primary');
                    btn.querySelector('i').classList.add('fill-current');
                } else {
                    btn.classList.add('text-muted', 'hover:text-white', 'hover:bg-white/5');
                    btn.classList.remove('bg-primary/10', 'text-primary');
                    btn.querySelector('i').classList.remove('fill-current');
                }
            });

            // View Switching
            document.querySelectorAll('#views-container > div').forEach(div => {
                if (div.id === `view-${tabId}`) {
                    div.classList.remove('hidden');
                    div.classList.remove('fade-enter');
                    void div.offsetWidth; // trigger reflow
                    div.classList.add('fade-enter');
                } else {
                    div.classList.add('hidden');
                }
            });

            // Title Update
            const titles = {
                'dashboard': 'Обзор Системы',
                'backtester': 'Бэктестер Стратегий',
                'scanner': 'Сканер Рынка',
                'queue': 'Менеджер Задач',
                'data': 'Управление Данными',
                'settings': 'Настройки'
            };
            document.getElementById('page-title').textContent = titles[tabId];
        }

        // --- BACKTESTER TABS ---
        function switchSettingsTab(tab) {
            const strategyTab = document.getElementById('tab-strategy');
            const portfolioTab = document.getElementById('tab-portfolio');
            const strategyContent = document.getElementById('settings-strategy');
            const portfolioContent = document.getElementById('settings-portfolio');

            if (tab === 'strategy') {
                strategyTab.classList.add('text-primary', 'border-b-2', 'border-primary', 'bg-primary/5');
                strategyTab.classList.remove('text-muted');
                portfolioTab.classList.remove('text-primary', 'border-b-2', 'border-primary', 'bg-primary/5');
                portfolioTab.classList.add('text-muted');
                
                strategyContent.classList.remove('hidden');
                portfolioContent.classList.add('hidden');
            } else {
                portfolioTab.classList.add('text-primary', 'border-b-2', 'border-primary', 'bg-primary/5');
                portfolioTab.classList.remove('text-muted');
                strategyTab.classList.remove('text-primary', 'border-b-2', 'border-primary', 'bg-primary/5');
                strategyTab.classList.add('text-muted');

                portfolioContent.classList.remove('hidden');
                strategyContent.classList.add('hidden');
            }
        }

        // --- MODAL LOGIC ---
        function openTradeModal() {
            document.getElementById('trade-modal').classList.remove('hidden');
        }
        function closeTradeModal() {
            document.getElementById('trade-modal').classList.add('hidden');
        }

        // --- AI LOGIC ---
        function toggleAIPanel() {
            document.getElementById('ai-panel').classList.toggle('translate-x-full');
        }

        async function analyzeStrategyWithAI() {
            toggleAIPanel();
            const fastMA = document.getElementById('input-fast-ma').value;
            const slowMA = document.getElementById('input-slow-ma').value;
            const sl = document.getElementById('input-sl').value;
            const tp = document.getElementById('input-tp').value;
            const prompt = `Act as a crypto quant. Analyze: Fast MA ${fastMA}, Slow MA ${slowMA}, SL ${sl}%, TP ${tp}%. Short Russian analysis with emojis.`;
            addMessageToChat('user', `Анализ: MA ${fastMA}/${slowMA}, SL ${sl}%, TP ${tp}%`);
            await callGeminiAPI(prompt);
        }

        async function sendMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;
            addMessageToChat('user', text);
            input.value = '';
            await callGeminiAPI(`User asks: "${text}". Answer in Russian as CryptoLab AI.`);
        }

        function addMessageToChat(role, text) {
            const container = document.getElementById('chat-messages');
            const div = document.createElement('div');
            div.className = 'flex gap-3 ' + (role === 'user' ? 'flex-row-reverse' : '');
            const avatar = role === 'user' 
                ? `<div class="w-8 h-8 rounded-full bg-surface2 border border-border flex-shrink-0 flex items-center justify-center text-xs text-muted"><i class="ph-bold ph-user"></i></div>`
                : `<div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-accent flex-shrink-0 flex items-center justify-center text-xs text-white mt-1">AI</div>`;
            const bubbleClass = role === 'user' ? 'bg-primary text-white rounded-2xl rounded-tr-none' : 'bg-surface border border-border text-slate-300 rounded-2xl rounded-tl-none';
            div.innerHTML = `${avatar}<div class="${bubbleClass} p-3 text-sm shadow-sm max-w-[85%]">${text}</div>`;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        async function callGeminiAPI(promptText) {
             const container = document.getElementById('chat-messages');
             const loadingDiv = document.createElement('div');
             loadingDiv.className = 'flex gap-3';
             loadingDiv.innerHTML = `<div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-accent flex-shrink-0 flex items-center justify-center text-xs text-white mt-1">AI</div><div class="bg-surface border border-border p-3 text-sm text-slate-300 rounded-2xl rounded-tl-none">...</div>`;
             container.appendChild(loadingDiv);
             container.scrollTop = container.scrollHeight;

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ contents: [{ parts: [{ text: promptText }] }] })
                });
                const data = await response.json();
                loadingDiv.remove();
                if (data.error) addMessageToChat('ai', 'Ошибка: ' + data.error.message);
                else {
                    const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || "Ошибка генерации.";
                    addMessageToChat('ai', reply.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>').replace(/\n/g, '<br>'));
                }
            } catch (error) {
                loadingDiv.remove();
                addMessageToChat('ai', 'Ошибка сети.');
            }
        }
        
        // Init default view
        switchTab('dashboard');
    </script>
