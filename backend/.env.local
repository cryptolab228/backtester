# Конфигурация для локальной разработки без Docker
NODE_ENV=development
PORT=5000

# PostgreSQL Database (локальные настройки)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=backtester_db

# Redis (локальные настройки)  
REDIS_HOST=localhost
REDIS_PORT=6379

# OKX API (заполните при необходимости)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Bybit API (заполните при необходимости)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_API_URL=https://api.bybit.com

# Настройки логирования
LOG_LEVEL=debug

# Настройки производительности
NODE_OPTIONS=--max-old-space-size=4096