{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only --ignore-watch node_modules --no-notify src/app.ts",
    "compare:cpu-gpu": "node dist/scripts/compareCpuGpu.js",
    "clean": "rmdir /s /q node_modules & rmdir /s /q dist",
    "reinstall": "npm run clean && npm install",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "verify-logic": "ts-node -r tsconfig-paths/register src/scripts/verify-strategy-logic.ts",
    "optimize:futures": "ts-node -r tsconfig-paths/register src/scripts/optimizeFuturesParameters.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.10.0",
    "backtester-v2": "file:..",
    "bullmq": "^5.7.13",
    "bybit-api": "^4.3.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "ioredis": "^5.6.1",
    "json-stable-stringify": "^1.0.1",
    "json2csv": "^5.0.7",
    "module-alias": "^2.2.3",
    "pg": "^8.15.6",
    "reflect-metadata": "^0.2.2",
    "technicalindicators": "^3.1.0",
    "typeorm": "^0.3.22",
    "winston": "^3.17.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "@types/winston": "^2.4.4",
    "@types/ws": "^8.18.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
